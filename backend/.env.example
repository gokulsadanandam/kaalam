# Comma-separated pages to scrape (HTML article or RSS feed), tried in order.
# Only use sources whose terms permit automated access.
RASIPALAN_SOURCES=

# Panchangam location (defaults to Chennai). Clients may override per request
# with ?lat=..&lon=..
DEFAULT_LAT=13.0827
DEFAULT_LON=80.2707

# Optional tuning
# CACHE_TTL_MS=10800000
# FAILURE_TTL_MS=900000
# FETCH_TIMEOUT_MS=6000
# PORT=3000

# Optional shared daily cache in Supabase (automatic inside Supabase Edge Functions).
# SUPABASE_URL=https://<project-ref>.supabase.co
# KAALAM_SUPABASE_KEY=          # service_role or sb_secret_… key — server side only, never in the app

# Enables POST /api/cron/scrape (sent by pg_cron as the x-cron-secret header).
# CRON_SECRET=
